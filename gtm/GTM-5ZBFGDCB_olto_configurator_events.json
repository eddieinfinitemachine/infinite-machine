              },
              {
                "type": "TEMPLATE",
                "key": "arg1",
                "value": "^(view_configurator|save_configuration|register_interest|form_submit|save_configuration_open|interest_form_open|select_color|select_bundle|add_accessory|remove_accessory|select_accessory_option|change_quantity|change_accessory_quantity|select_pay_mode|select_country|open_rep_chat|play_accessory_video|save_design_image|clear_configuration)$"
              }
            ]
